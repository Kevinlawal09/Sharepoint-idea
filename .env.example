# Copy this file to .env (same folder) and fill it in. .env is gitignored — never commit it.
# Leave the MS_* values blank to run on sample data with the type-your-name login.

# From the app registration's Overview page in the Entra admin center
MS_TENANT_ID=
MS_CLIENT_ID=
# From Certificates & secrets > Client secrets (copy the Value, not the Secret ID)
MS_CLIENT_SECRET=

# The shared mailbox whose calendar holds staff events, e.g. events@unitedwaypbc.org
# Leave blank to keep the sample events.
MS_EVENTS_CALENDAR=

# Set to true only after an admin grants consent for User.Read.All: the directory then
# shows titles, departments, and phones (not just names, emails, and photos).
MS_FULL_DIRECTORY=false

# Optional
# MS_REDIRECT_URI=http://localhost:4100/auth/callback
# MS_TIMEZONE=Eastern Standard Time
# MS_EVENTS_DAYS=60
# PORT=4100
